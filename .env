# ==============================================================================
# RustFS Core Configuration Template
# ==============================================================================
PUID=1001
GUID=1001

# 1. ROOT CREDENTIALS (CHANGE THESE FOR PRODUCTION)
# Use secure, unique alpha-numeric strings. Do not use 'rustfsadmin' in production.
RUSTFS_ACCESS_KEY=LSf2gDACKm7e40fipSRGqjvB
RUSTFS_SECRET_KEY=AEEHGEYLUiX9iHs4WOTLKTxpKTRk7iCv

# 2. NETWORKING & PORTS
# S3 API main traffic endpoint
RUSTFS_ADDRESS=":9000"
# CORS permissions for the primary S3 API
RUSTFS_CORS_ALLOWED_ORIGINS="*"

# 3. WEB CONSOLE (GUI) SETTINGS
# Toggle the embedded graphical user interface (true/false)
RUSTFS_CONSOLE_ENABLE=true
# Network port assigned to the Web UI
RUSTFS_CONSOLE_ADDRESS=":9001"
# CORS permissions specifically for the web console dashboard
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS="*"

# 4. STORAGE VOLUMES
# Directory where files and buckets are physically stored on the machine/container
RUSTFS_VOLUMES="/data"

# 5. OBSERVABILITY & SYSTEM LOGS
# Environment deployment tier tag
RUSTFS_OBS_ENVIRONMENT=production
# Log directory pathway
RUSTFS_OBS_LOG_DIRECTORY="/logs"
# Log verbosity threshold: error, warn, info, or debug
RUSTFS_OBS_LOGGER_LEVEL=warn
